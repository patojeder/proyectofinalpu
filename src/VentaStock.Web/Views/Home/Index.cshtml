@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-dark">VENTA-STOCK</h1>
        <p class="text-muted">Seleccione un módulo para comenzar a operar</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="row g-4 justify-content-center">
            @if (CurrentUser.HasPermission(SalesPermissions.Create) || CurrentUser.HasPermission(SalesPermissions.Read))
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm border text-center p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h4 class="card-title fw-semibold text-dark mb-4">Ventas</h4>
                            <button class="btn btn-outline-secondary w-100 py-2" disabled>
                                Próximamente
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (CurrentUser.HasPermission(CategoryPermissions.Read) || CurrentUser.HasPermission(CategoryPermissions.Create))
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm border text-center p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h4 class="card-title fw-semibold text-dark mb-4">Categorías</h4>
                            <a asp-controller="Category" asp-action="@(CurrentUser.HasPermission(CategoryPermissions.Read) ? "Index" : "Create")" class="btn btn-success w-100 py-2">
                                Ingresar
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (CurrentUser.HasPermission(ServicePermissions.Read) || CurrentUser.HasPermission(ServicePermissions.Create))
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm border text-center p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h4 class="card-title fw-semibold text-dark mb-4">Servicios</h4>
                            <a asp-controller="Service" asp-action="@(CurrentUser.HasPermission(ServicePermissions.Read) ? "Index" : "Create")" class="btn btn-primary w-100 py-2">Ingresar</a>
                        </div>
                    </div>
                </div>
            }

            @if (CurrentUser.HasPermission(UserPermissions.Read) || CurrentUser.HasPermission(UserPermissions.Create))
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm border text-center p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h4 class="card-title fw-semibold text-dark mb-4">Gestión de Usuarios</h4>
                            <a asp-controller="User" asp-action="@(CurrentUser.HasPermission(UserPermissions.Read) ? "Index" : "Create")" class="btn btn-primary w-100 py-2">
                                Ingresar
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center mt-4">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary px-4 py-2">
                Iniciar Sesión
            </a>
        </div>
    }
</div>
