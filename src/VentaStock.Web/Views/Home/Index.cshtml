@{
    ViewData["Title"] = "Inicio";
    var esOwner = User.IsInRole("Owner");
    var esUserManager = User.IsInRole("UserManager");
    var esVendedor = User.IsInRole("Vendedor");
}

<div class="container py-5">
    <!-- Encabezado simple y despejado -->
    <div class="text-center mb-5">
        <h1 class="fw-bold text-dark">VENTA-STOCK</h1>
        <p class="text-muted">Seleccione un módulo para comenzar a operar</p>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="row g-4 justify-content-center">
            <!-- Módulo Punto de Venta (Owner y Vendedor) -->
            @if (esOwner || esVendedor)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm border text-center p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h4 class="card-title fw-semibold text-dark mb-4">Ventas</h4>
                            <button class="btn btn-outline-secondary w-100 py-2" disabled>
                                Próximamente
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Módulo Stock e Inventario (Owner y Vendedor) -> Lleva a Categorías -->
            @if (esOwner || esVendedor)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm border text-center p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h4 class="card-title fw-semibold text-dark mb-4">Stock e Inventario</h4>
                            <a asp-controller="Category" asp-action="Index" class="btn btn-success w-100 py-2">
                                Ingresar
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (esOwner || esUserManager)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm border text-center p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h4 class="card-title fw-semibold text-dark mb-4">Gestión de Usuarios</h4>
                            <a asp-controller="User" asp-action="Index" class="btn btn-primary w-100 py-2">
                                Ingresar
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center mt-4">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary px-4 py-2">
                Iniciar Sesión
            </a>
        </div>
    }
</div>