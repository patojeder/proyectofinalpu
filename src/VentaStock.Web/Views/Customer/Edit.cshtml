@model VentaStock.Application.DTOs.EditCustomerDto
@{ ViewData["Title"] = "Editar cliente"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4">Editar cliente</h3>
                    <form autocomplete="off" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
                        <partial name="_Fields" model="Model" />
                        <div class="d-flex flex-wrap justify-content-end gap-2">
                            <a asp-controller="@(CurrentUser.HasPermission(CustomerPermissions.Read) ? "Customer" : "Home")" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
