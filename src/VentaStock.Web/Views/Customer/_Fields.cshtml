@model VentaStock.Application.DTOs.CreateCustomerDto
@using VentaStock.Domain.Constants

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="FirstName" class="form-label fw-semibold"></label>
        <input asp-for="FirstName" class="form-control" autofocus />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="LastName" class="form-label fw-semibold"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="col-sm-4 mb-3">
        <label asp-for="DocumentType" class="form-label fw-semibold"></label>
        <select asp-for="DocumentType" class="form-select">
            <option value="@DocumentTypes.Dni">DNI</option>
            <option value="@DocumentTypes.Cuil">CUIL</option>
            <option value="@DocumentTypes.Cuit">CUIT</option>
        </select>
        <span asp-validation-for="DocumentType" class="text-danger"></span>
    </div>
    <div class="col-sm-8 mb-3">
        <label asp-for="DocumentNumber" class="form-label fw-semibold"></label>
        <input asp-for="DocumentNumber" class="form-control" inputmode="numeric" aria-describedby="document-help" />
        <div id="document-help" class="form-text">CUIL/CUIT: 11 dígitos, con o sin guiones. Se comprueba el dígito verificador.</div>
        <span asp-validation-for="DocumentNumber" class="text-danger"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="CustomerType" class="form-label fw-semibold"></label>
    @if (CurrentUser.HasPermission(CustomerPermissions.CreateOnAccount) || Model is VentaStock.Application.DTOs.EditCustomerDto)
    {
        <select asp-for="CustomerType" class="form-select" aria-describedby="type-help">
            <option value="@CustomerTypes.Cash">Contado</option>
            <option value="@CustomerTypes.OnAccount">Cuenta corriente</option>
        </select>
        <div id="type-help" class="form-text">Los clientes de cuenta corriente deben tener CUIL o CUIT. Habilitar ese tipo requiere permiso específico.</div>
    }
    else
    {
        <input type="hidden" asp-for="CustomerType" />
        <p class="form-control-plaintext">Contado</p>
    }
    <span asp-validation-for="CustomerType" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Address" class="form-label"></label>
    <input asp-for="Address" class="form-control" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" type="tel" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
</div>
<p class="text-muted small mb-4">La dirección y el teléfono son opcionales.</p>
