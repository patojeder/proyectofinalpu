@model VentaStock.Application.DTOs.CustomerIndexDto
@using VentaStock.Domain.Constants
@{
    ViewData["Title"] = "Clientes";
    var canUpdate = CurrentUser.HasPermission(CustomerPermissions.Update);
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h2 class="fw-bold mb-1">Clientes</h2><p class="text-muted mb-0">Clientes de contado y cuenta corriente</p></div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al inicio</a>
            @if (CurrentUser.HasPermission(CustomerPermissions.Create))
            {
                <a asp-action="Create" class="btn btn-primary">+ Nuevo cliente</a>
            }
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }
    <form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
        <div class="col-md-8">
            <label asp-for="Search" class="form-label">Nombre, apellido, documento o teléfono</label>
            <input asp-for="Search" class="form-control" maxlength="150" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr>
                    <th>Apellido</th><th>Nombre</th><th>Documento</th><th>Tipo</th><th>Dirección</th><th>Teléfono</th>
                    @if (canUpdate) { <th class="text-end">Acciones</th> }
                </tr></thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="@(canUpdate ? 7 : 6)" class="text-center py-4 text-muted">No hay clientes que coincidan con la búsqueda.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold">@item.LastName</td><td>@item.FirstName</td>
                            <td class="text-nowrap">@item.DocumentType @item.DocumentNumber</td>
                            <td>@(item.CustomerType == CustomerTypes.OnAccount ? "Cuenta corriente" : "Contado")</td>
                            <td>@(item.Address ?? "—")</td><td>@(item.Phone ?? "—")</td>
                            @if (canUpdate)
                            {
                                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
