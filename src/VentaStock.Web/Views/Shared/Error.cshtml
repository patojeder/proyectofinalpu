@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar la solicitud.</h2>
<p>Volvé a intentarlo. Si el problema continúa, contactá al responsable del sistema.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador del error:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Volver al Inicio</a>
