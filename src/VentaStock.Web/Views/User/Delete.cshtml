@model VentaStock.Application.DTOs.DeleteUserDto

@{
    ViewData["Title"] = "Dar de Baja Usuario";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Confirmar Baja de Usuario</h4>
                </div>
                <div class="card-body">
                    <p class="text-danger fw-bold">¿Está seguro de que desea dar de baja al siguiente usuario?</p>
                    
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Nombre de Usuario:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.NombreUsuario</dd>

                        <dt class="col-sm-4 text-muted">Correo Electrónico:</dt>
                        <dd class="col-sm-8">@Model.Mail</dd>

                        <dt class="col-sm-4 text-muted">Rol:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.Rol</span>
                        </dd>
                    </dl>

                    <form asp-action="Delete" asp-route-id="@Model.IdUsuario" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdUsuario" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Confirmar Baja</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>