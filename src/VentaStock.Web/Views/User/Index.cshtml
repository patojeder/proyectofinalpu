@model IEnumerable<VentaStock.Application.DTOs.UserDto>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Usuarios</h2>
        @if (CurrentUser.HasPermission(UserPermissions.Create))
        {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Usuario
        </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Usuario</th>
                        <th>Correo Electrónico</th>
                        <th>Rol</th>
                        <th>Fecha de Alta</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-bold">@user.NombreUsuario</td>
                                <td>@user.Mail</td>
                                <td>
                                    <span class="badge bg-secondary">@user.Rol</span>
                                </td>
                                <td>@user.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-3">
                                    @if (CurrentUser.HasPermission(UserPermissions.Update) &&
                                        (CurrentUser.IsOwner || !string.Equals(user.Rol, UserPermissions.OwnerRole, StringComparison.OrdinalIgnoreCase)))
                                    {
                                    <a asp-action="Edit" asp-route-id="@user.IdUsuario" class="btn btn-sm btn-outline-primary me-1">
                                        Editar
                                    </a>
                                    }
                                    @if (CurrentUser.HasPermission(UserPermissions.Deactivate) &&
                                        (CurrentUser.IsOwner || !string.Equals(user.Rol, UserPermissions.OwnerRole, StringComparison.OrdinalIgnoreCase)))
                                    {
                                    <a asp-action="Delete" asp-route-id="@user.IdUsuario" class="btn btn-sm btn-outline-danger">
                                        Baja
                                    </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No se encontraron usuarios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>