@model IEnumerable<VentaStock.Application.DTOs.UserDto>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    var searchTerm = ViewData["SearchTerm"] as string ?? string.Empty;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Usuarios</h2>
        @if (CurrentUser.HasPermission(UserPermissions.Create))
        {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Usuario
        </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <form asp-action="Index" method="get" autocomplete="off" class="row g-2 align-items-end mb-3">
        <div class="col-md-6">
            <label for="search" class="form-label">Buscar por usuario, rol o sucursal</label>
            <input type="search" id="search" name="search" value="@searchTerm" class="form-control" maxlength="150" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Sucursales</th>
                        <th>Fecha de Alta</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            var isOwnerUser = string.Equals(user.Role, SystemRoles.Owner, StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td class="fw-bold">@user.UserName</td>
                                <td>
                                    <span class="badge bg-secondary">@user.Role</span>
                                </td>
                                <td>
                                    @if (isOwnerUser)
                                    {
                                        <span class="text-muted">Todas (Dueño)</span>
                                    }
                                    else if (user.Branches.Count > 0)
                                    {
                                        @string.Join(", ", user.Branches)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin asignar</span>
                                    }
                                </td>
                                <td>@user.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-3">
                                    @if (CurrentUser.HasPermission(UserPermissions.Update) &&
                                        (CurrentUser.IsOwner || !isOwnerUser))
                                    {
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-1">
                                        Editar
                                    </a>
                                    }
                                    @if (CurrentUser.HasPermission(UserPermissions.Delete) &&
                                        (CurrentUser.IsOwner || !isOwnerUser))
                                    {
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                                        Eliminar
                                    </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                @(string.IsNullOrEmpty(searchTerm) ? "No hay usuarios registrados." : "No se encontraron usuarios con ese criterio.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
