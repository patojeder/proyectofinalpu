@model VentaStock.Application.DTOs.EditUserDto

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Editar Usuario</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.IdUsuario" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdUsuario" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NombreUsuario" class="form-label"></label>
                            <input asp-for="NombreUsuario" class="form-control" />
                            <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Mail" class="form-label"></label>
                            <input asp-for="Mail" class="form-control" type="email" />
                            <span asp-validation-for="Mail" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdRol" class="form-label"></label>
                            <select asp-for="IdRol" asp-items="ViewBag.Roles" class="form-select">
                                <option value="">-- Seleccionar Rol --</option>
                            </select>
                            <span asp-validation-for="IdRol" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />
                        <h6 class="text-muted mb-3">Cambio de Contraseña (dejar vacío para mantener la actual)</h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewPassword" class="form-label"></label>
                                <input asp-for="NewPassword" class="form-control" placeholder="Opcional" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Opcional" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Actualizar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}