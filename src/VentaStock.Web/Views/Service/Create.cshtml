@model VentaStock.Application.DTOs.CreateServiceDto

@{
    ViewData["Title"] = "Nuevo Servicio";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-3">Nuevo Servicio</h3>
                    <p class="text-muted mb-4">Registrá un servicio del catálogo. El precio se definirá al realizar la venta.</p>
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <partial name="_Fields" model="Model" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="@(CurrentUser.HasPermission(ServicePermissions.Read) ? "Service" : "Home")" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar Servicio</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
