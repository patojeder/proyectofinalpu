@model VentaStock.Application.DTOs.DeleteServiceDto

@{
    ViewData["Title"] = "Eliminar Servicio";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 border-top border-4 border-danger">
                <div class="card-body p-4">
                    <h4 class="fw-bold text-danger mb-3">Eliminar Servicio</h4>
                    <p>¿Querés eliminar definitivamente este servicio?</p>
                    <dl class="bg-light p-3 rounded">
                        <dt>Nombre</dt>
                        <dd>@Model.Name</dd>
                        <dt>Descripción</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
                        <dt>Categorías</dt>
                        <dd>@(Model.Categories.Count == 0 ? "Sin categorías" : string.Join(", ", Model.Categories))</dd>
                    </dl>
                    <form autocomplete="off" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="@(CurrentUser.HasPermission(ServicePermissions.Read) ? "Service" : "Home")" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
