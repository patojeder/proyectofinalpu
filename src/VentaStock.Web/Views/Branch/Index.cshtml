@model IEnumerable<VentaStock.Application.DTOs.BranchDto>

@{
    ViewData["Title"] = "Sucursales";
    var searchTerm = ViewData["SearchTerm"] as string ?? string.Empty;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Sucursales</h2>
            <p class="text-muted mb-0">Administración de sucursales (exclusivo para el Dueño)</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Volver al inicio</a>
            <a asp-action="Create" class="btn btn-primary">+ Nueva sucursal</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    <form asp-action="Index" method="get" autocomplete="off" class="row g-2 align-items-end mb-3">
        <div class="col-md-6">
            <label for="search" class="form-label">Buscar por nombre, dirección o teléfono</label>
            <input type="search" id="search" name="search" value="@searchTerm" class="form-control" maxlength="150" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                @(string.IsNullOrEmpty(searchTerm) ? "No hay sucursales registradas." : "No se encontraron sucursales con ese criterio.")
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Address) ? "—" : item.Address)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Phone) ? "—" : item.Phone)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

