@model VentaStock.Application.DTOs.CreateBranchDto
@{ ViewData["Title"] = "Nueva sucursal"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-3">Nueva sucursal</h3>
                    <p class="text-muted">Al crear la sucursal se inicializará el stock en 0 para los productos existentes.</p>
                    <form autocomplete="off" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <partial name="_Fields" model="Model" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar sucursal</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

