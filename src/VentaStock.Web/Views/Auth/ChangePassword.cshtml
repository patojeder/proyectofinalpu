@model VentaStock.Application.DTOs.ChangeTemporaryPasswordDto

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-2">Elegí una contraseña propia</h3>
                <p class="text-muted">Por seguridad, antes de continuar tenés que reemplazar la contraseña temporal.</p>

                <form autocomplete="off" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" data-password-toggle aria-controls="NewPassword" aria-pressed="false" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                                <svg data-password-icon="show" class="password-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                                <svg data-password-icon="hide" class="password-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /><path d="m3 3 18 18" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" data-password-toggle aria-controls="ConfirmPassword" aria-pressed="false" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                                <svg data-password-icon="show" class="password-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                                <svg data-password-icon="hide" class="password-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /><path d="m3 3 18 18" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-2">Guardar contraseña</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
