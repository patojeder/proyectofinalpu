@model VentaStock.Application.DTOs.DeleteCategoryDto

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 border-top border-4 border-danger">
                <div class="card-body p-4">
                    <h4 class="fw-bold text-danger mb-2">Eliminar Categoría</h4>
                    <p class="text-muted mb-4">¿Está seguro de que desea eliminar definitivamente la siguiente categoría?</p>

                    <div class="bg-light p-3 rounded mb-4">
                        <div class="mb-2">
                            <span class="text-muted small">Nombre:</span>
                            <div class="fw-bold text-dark">@Model.Nombre</div>
                        </div>
                        <div>
                            <span class="text-muted small">Descripción:</span>
                            <div class="text-secondary">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "-" : Model.Descripcion)</div>
                        </div>
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.IdCategoria" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdCategoria" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="@(CurrentUser.HasPermission(CategoryPermissions.Read) ? "Category" : "Home")" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
