@model VentaStock.Application.DTOs.StockReceiptDto
@{ ViewData["Title"] = "Registrar ingreso"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-3">Registrar ingreso</h3>
                    <p class="text-muted">La cantidad ingresada se suma a las existencias actuales, incluso cuando sean negativas.</p>
                    <partial name="_Product" model="Model.Product" />
                    <form asp-action="Receipt" asp-route-id="@Model.ProductId" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="ProductId" type="hidden" />
                        <input asp-for="OperationId" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label"></label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" step="1" autofocus />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Reason" class="form-label"></label>
                            <textarea asp-for="Reason" class="form-control" rows="3" maxlength="500"></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Confirmar ingreso</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
