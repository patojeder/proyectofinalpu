@model VentaStock.Application.DTOs.CreateProductDto
@{ ViewData["Title"] = "Nuevo producto"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4">Nuevo producto</h3>
                    <p class="text-muted">Las existencias iniciales serán 0. Los ingresos se registrarán mediante movimientos de stock.</p>
                    <form autocomplete="off" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <partial name="_Fields" model="Model" />

                        @if (CurrentUser.HasPermission(ProductPermissions.UpdatePrices)
                            && CurrentUser.HasPermission(ProductPermissions.ReadCost)
                            && CurrentUser.HasPermission(ProductPermissions.ReadSalePrice))
                        {
                            <fieldset class="mb-4">
                                <legend class="h5">Precios</legend>
                                <p class="text-muted small">Podés dejar ambos vacíos y asignarlos más adelante. El precio de venta debe superar el costo.</p>
                                <div class="row">
                                    <div class="col-sm-6 mb-3">
                                        <label asp-for="CostPrice" class="form-label"></label>
                                        <input asp-for="CostPrice" class="form-control" type="number" min="0" step="0.01" data-no-exponent />
                                        <span asp-validation-for="CostPrice" class="text-danger"></span>
                                    </div>
                                    <div class="col-sm-6 mb-3">
                                        <label asp-for="SalePrice" class="form-label"></label>
                                        <input asp-for="SalePrice" class="form-control" type="number" min="0" step="0.01" data-no-exponent />
                                        <span asp-validation-for="SalePrice" class="text-danger"></span>
                                    </div>
                                </div>
                            </fieldset>
                        }

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="@(CurrentUser.HasPermission(ProductPermissions.Read) ? "Product" : "Home")" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar producto</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
