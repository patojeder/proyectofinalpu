@model VentaStock.Application.DTOs.EditProductDto
@{ ViewData["Title"] = "Editar producto"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4">Editar producto</h3>
                    
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <partial name="_Fields" model="Model" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="@(CurrentUser.HasPermission(ProductPermissions.Read) ? "Product" : "Home")" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
