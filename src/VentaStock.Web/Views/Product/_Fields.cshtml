@model VentaStock.Application.DTOs.ProductFieldsDto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3">
    <label asp-for="Name" class="form-label fw-semibold"></label>
    <input asp-for="Name" class="form-control" autofocus />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label fw-semibold"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
</div>
<div class="mb-3">
    <label asp-for="Barcode" class="form-label fw-semibold"></label>
    <input asp-for="Barcode" class="form-control" aria-describedby="barcode-help" />
    <div id="barcode-help" class="form-text">Opcional. Al crear sin código se asigna uno interno único. Al editar, dejarlo vacío conserva el código actual.</div>
    <span asp-validation-for="Barcode" class="text-danger"></span>
</div>
<div class="mb-4">
    <label asp-for="CategoryIds" class="form-label fw-semibold"></label>
    <select asp-for="CategoryIds" asp-items="ViewBag.Categories" class="form-select" multiple size="5" aria-describedby="categories-help"></select>
    <div id="categories-help" class="form-text">Seleccioná al menos una categoría. Podés elegir varias con Ctrl.</div>
    <span asp-validation-for="CategoryIds" class="text-danger"></span>
</div>
