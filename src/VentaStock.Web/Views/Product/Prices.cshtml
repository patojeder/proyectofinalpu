@model VentaStock.Application.DTOs.ProductPricesDto
@{ ViewData["Title"] = "Editar precios"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-3">Editar precios</h3>
                    <p class="text-muted">Producto: <strong>@Model.Name</strong>. Indicá ambos precios o dejá ambos vacíos para quitar la asignación. El precio de venta debe superar el costo.</p>
                    <form asp-action="Prices" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="CostPrice" class="form-label"></label>
                            <input asp-for="CostPrice" class="form-control" type="number" min="0" step="0.01" />
                            <span asp-validation-for="CostPrice" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="SalePrice" class="form-label"></label>
                            <input asp-for="SalePrice" class="form-control" type="number" min="0" step="0.01" />
                            <span asp-validation-for="SalePrice" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="@(CurrentUser.HasPermission(ProductPermissions.Read) ? "Product" : "Home")" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar precios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
