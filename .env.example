# Ejemplo público: copiar a .env y reemplazar los marcadores con valores locales.
# ASP.NET Core NO carga este archivo automáticamente.
# Configurar las variables en el proceso/servicio o usar User Secrets en desarrollo.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__VentaStock="Server=localhost,1433;Database=VentaStock;User Id=REEMPLAZAR_USUARIO;Password=REEMPLAZAR_PASSWORD;Encrypt=True;TrustServerCertificate=True;"

# Reservadas para una futura API con JWT; la app MVC actual no las utiliza.
Jwt__Issuer="VentaStock"
Jwt__Audience="VentaStock.Api"
Jwt__SigningKey="REEMPLAZAR_CON_UN_SECRETO_ALEATORIO"
